{
  "expo": {
    "name": "Hell Yeah App",
    "slug": "hell-yeah-app-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "hellyeahapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hellyeahapp.rn",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to take photos.",
        "NSPhotoLibraryUsageDescription": "This app requires gallery access to select photos.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to tag where you had your beer."
      }
    },
    "android": {
      "package": "com.hellyeahapp.rn",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Hell Yeah",
      "shortName": "Hell Yeah",
      "description": "Track your beers with friends!",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Fotoğraf çekmek için kamera izni gereklidir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galeriden fotoğraf seçmek için izin gereklidir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to tag where you had your beer."
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "78dac0ba-42ea-41b2-90d4-357bbabce184"
      }
    }
  }
}
