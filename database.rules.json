{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",

        // --- Kullanıcının güvenli alanları: sadece kendi profilini güncelleyebilir ---
        "displayName": {
          ".write": "$uid === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "avatar": {
          ".write": "$uid === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "username": {
          ".write": "$uid === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 30 && newData.val().matches(/^[a-z0-9._]+$/)"
        },
        "email": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isString()"
        },

        // --- Sayaçlar: sadece increment (server value) ile güncellenebilir ---
        // Not: Firebase RTDB'de ServerValue.increment() kullanıldığında
        // newData.val() doğrudan erişilemez, bu yüzden "sahiplik" kontrolü yapıyoruz
        "totalBeers": {
          ".write": "$uid === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isNumber()"
        },
        "totalGuinnessBeers": {
          ".write": "$uid === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isNumber()"
        },
        "beersByYear": {
          "$year": {
            ".write": "$uid === auth.uid && auth.token.email_verified === true",
            ".validate": "newData.isNumber()"
          }
        },
        "guinnessByYear": {
          "$year": {
            ".write": "$uid === auth.uid && auth.token.email_verified === true",
            ".validate": "newData.isNumber()"
          }
        },

        // --- Oluşturulma tarihi: immutable ---
        "createdAt": {
          ".write": "$uid === auth.uid && !data.exists()",
          ".validate": "newData.isString()"
        },

        // --- Arkadaşlar: özel kural ---
        // Kendi friends düğümüne yazabilir VEYA
        // Karşı taraf kabul ederken/silerken yazabilir (atomik multi-path update için)
        "friends": {
          "$friendId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.token.email_verified === true && ($uid === auth.uid || $friendId === auth.uid)"
          }
        }
      }
    },

    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $username.matches(/^[a-z0-9._]+$/) && $username.length >= 3 && $username.length <= 30"
      }
    },

    "beers": {
      ".read": "auth != null",
      ".indexOn": ["userId", "timestamp"],
      "$beerId": {
        // --- Ana bira alanları: yalnızca sahip yazabilir ---
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid) && (!newData.exists() || newData.child('userId').val() === data.child('userId').val() || !data.exists())",

        // --- Bira oluşturma doğrulaması ---
        "userId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "userAvatar": {
          ".validate": "newData.isString()"
        },
        "photoUrl": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "year": {
          ".validate": "newData.isNumber()"
        },
        "isGuinness": {
          ".validate": "newData.isBoolean()"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },

        // --- Reaksiyonlar: herkes kendi UID düğümünü yazıp silebilir ---
        "reactions": {
          "$reactorUid": {
            ".write": "auth != null && auth.token.email_verified === true && $reactorUid === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4"
          }
        },

        // --- Yorumlar: oluşturma — userId === auth.uid; silme — yorum sahibi ---
        "comments": {
          "$commentId": {
            ".write": "auth != null && auth.token.email_verified === true && (!data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['userId', 'userName', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 500 && newData.child('userId').isString() && newData.child('userId').val() === auth.uid && newData.child('userName').isString() && newData.child('timestamp').isNumber())"
          }
        }
      }
    },

    "friendRequests": {
      "$toUserId": {
        ".read": "$toUserId === auth.uid",
        "$fromUserId": {
          // Oluşturma: yalnız gönderen ($fromUserId === auth.uid)
          // Silme (kabul/red): yalnız alıcı ($toUserId === auth.uid) VEYA gönderen
          ".write": "auth != null && auth.token.email_verified === true && ($fromUserId === auth.uid || $toUserId === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUserId', 'toUserId', 'status', 'timestamp']) && newData.child('fromUserId').val() === $fromUserId && newData.child('fromUserId').val() === auth.uid && newData.child('toUserId').val() === $toUserId && newData.child('status').isString() && newData.child('timestamp').isNumber())"
        }
      }
    },

    // --- Email-to-UID mapping (opsiyonel, kısıtlı erişim) ---
    "emails": {
      "$encodedEmail": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true",
        ".validate": "newData.isString()"
      }
    }
  }
}
