{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid",
        "friends": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "beers": {
      ".read": "auth != null",
      ".indexOn": ["userId", "timestamp"],
      "$beerId": {
        ".write": "auth != null && (!data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid)"
      }
    },
    "friendRequests": {
      "$toUserId": {
        ".read": "$toUserId === auth.uid",
        "$fromUserId": {
          ".write": "auth != null && ($fromUserId === auth.uid || $toUserId === auth.uid)"
        }
      }
    }
  }
}
