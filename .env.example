# Environment Variables Example
# Copy this file to .env and fill in your values

# Master Password for Admin Access
# SECURITY WARNING: This should ONLY be used in development/testing
# Leave empty or remove in production builds
MASTER_PASSWORD=

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
