# Environment Variables Example
# Copy this file to .env and fill in your values

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# SECURITY NOTE:
# Do NOT add secrets like MASTER_PASSWORD, API keys, or admin credentials here.
# React Native/Expo bundles env vars into the client — they are NOT secret.
# Use Firebase Custom Claims + Cloud Functions for admin operations.
